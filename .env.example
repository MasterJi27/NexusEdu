# ============================================================================
# Nexus Edu — environment variables
# ============================================================================

# --- Backend (Express + Prisma, Azure App Service) ---
DATABASE_URL=postgresql://user:password@host:5432/nexus_edu?schema=public
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# AI provider keys (all AI calls are proxied through the backend — never ship
# these inside the compiled Flutter app)
GROQ_API_KEY=your_groq_key_here
# Optional overrides
AI_MODEL=llama-3.1-8b-instant
DAILY_AI_QUOTA_TOKENS=200000
WOLFRAM_APP_ID=your_wolfram_app_id_here

# --- RAG (free embeddings, no cost) ---
# EMBEDDING_PROVIDER=groq → nomic-embed-text-v1_5 (reuses GROQ_API_KEY)
# EMBEDDING_PROVIDER=openrouter → nvidia/nemotron-3-embed-1b:free (needs
# OPENROUTER_API_KEY below)
RAG_ENABLED=true
EMBEDDING_PROVIDER=groq
EMBEDDING_MODEL=
# Optional: only needed when EMBEDDING_PROVIDER=openrouter
OPENROUTER_API_KEY=

# --- Auth / OAuth ---
# Google OAuth web/server client ID used to verify Google sign-in ID tokens
GOOGLE_SERVER_CLIENT_ID=your_web_client_id_here
MAX_ACTIVE_DEVICE_SESSIONS=2

# --- Parent digest email delivery ---
# Delivery order: Composio Gmail first, then SMTP. With neither configured the
# digest stays in-app only.
# Composio (agent platform) — get a key at console.composio.dev, then run
# `npm run composio:connect` in backend/ and approve Google access once.
COMPOSIO_API_KEY=ak_your_composio_key_here
# SMTP fallback (any provider). Not needed when Composio Gmail is connected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM_EMAIL=Nexus Edu <digest@nexusedu.app>
DIGEST_ENABLED=true

# --- Deployment ---
# Comma-separated list of allowed CORS origins (empty in dev = allow all)
ALLOWED_ORIGINS=
APP_URL=http://localhost:3000

# Optional: Azure Blob storage for avatar uploads
AZURE_STORAGE_CONNECTION_STRING=

# --- Flutter app (dev only) ---
# Optional YouTube Data API key for live educational-short discovery.
# Without this, Nexus uses the bundled syllabus-safe video catalog.
YOUTUBE_API_KEY=your_youtube_api_key_here
