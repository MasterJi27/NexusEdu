# Backend build output
/backend/dist/

# local postgres dev binaries + data
/.local/
backend/server.log
backend/server.log.err

# Android signing credentials (never commit)
android/key.properties
*.jks
*.aab
*.apk
*.ipa

# Play Store screenshots — large generated PNGs (1.6 MB each), regenerable via screenshot tool
/playstore_screenshots/phone/
playstore_screenshots/phone/

# AI coding-tool scratch/config output — not project source
.artifacts/
.codex/
opencode.json

