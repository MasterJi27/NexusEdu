{
  "name": "backend",
  "version": "1.0.0",
  "description": "Nexus Edu API — Express + Prisma backend with AI proxy, JWT auth, rate limiting and token usage tracking",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node startup.js",
    "postinstall": "node -e \"try{if(require('fs').existsSync('prisma/schema.prisma')){require('child_process').execSync('npx prisma generate',{stdio:'inherit'})}else{console.log('prisma generate skipped: no schema in build dir')}}catch(e){console.warn('prisma generate skipped:',e.message)}\"",
    "prisma:generate": "prisma generate",
    "composio:connect": "node scripts/composio-connect.cjs",
    "seed:rag": "ts-node seed/seedRag.ts",
    "test": "vitest run"
  },
  "keywords": [
    "edtech",
    "ai",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@composio/core": "^0.15.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "agora-token": "^2.0.5",
    "applicationinsights": "^3.15.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "p-limit": "^3.1.0",
    "p-retry": "^6.1.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pino": "^9.3.2",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
