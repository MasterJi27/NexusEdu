# Copy to .env and fill in. See backend/src/lib/env.ts for how each of these
# is consumed — that file is the source of truth, this is just a template.

# --- Required ---------------------------------------------------------
JWT_SECRET=your-jwt-secret-here
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_edu

# --- Core ----------------------------------------------------------------
NODE_ENV=development
# Comma-separated list of origins allowed to call the API. Empty denies all
# cross-origin requests (the Flutter app isn't affected — CORS only applies
# to browsers). Set ALLOW_ALL_ORIGINS_DEV=true locally instead if you need a
# browser-based dev client with no fixed origin.
ALLOWED_ORIGINS=
ALLOW_ALL_ORIGINS_DEV=false
GOOGLE_SERVER_CLIENT_ID=

# --- AI (Groq, free tier) -------------------------------------------------
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
WOLFRAM_APP_ID=

# --- RAG (free embeddings) ------------------------------------------------
# provider is 'groq' (nomic-embed-text-v1_5, reuses GROQ_API_KEY — only if
# the Groq account has embeddings access) or 'openrouter' (nvidia/nemotron-
# 3-embed-1b:free). RAG_ENABLED=false turns retrieval off entirely.
RAG_ENABLED=true
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=
OPENROUTER_API_KEY=

# --- App URL / dev convenience --------------------------------------------
APP_URL=http://localhost:3000
# NEVER set this to true in production; forgot-password must deliver tokens
# out-of-band, not echo them in the API response.
DEV_ALLOW_RESET_TOKEN_IN_RESPONSE=false

# --- Parent digest email ---------------------------------------------------
# Composio (preferred — see DEPLOYMENT.md section 4c). Delivery order is
# Composio -> SMTP -> in-app only.
COMPOSIO_API_KEY=
# Optional SMTP fallback. When unset, the digest is in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM_EMAIL=Nexus Edu <digest@nexusedu.app>
DIGEST_ENABLED=true

# --- Azure AI services (free F0 tiers) --------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# When all three are set, AI answers use Azure OpenAI instead of Groq.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_DOC_INTEL_KEY=
AZURE_DOC_INTEL_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# --- Monitoring --------------------------------------------------------------
# When unset, Application Insights monitoring is off.
APP_INSIGHTS_CONNECTION_STRING=
# Prometheus /metrics auth — required for non-internal scrapes (10.0.* bypasses)
METRICS_TOKEN=

# --- Agora (live classes) ----------------------------------------------------
# Free account at console.agora.io. Both required to start/join a live class —
# App Certificate is what lets the backend mint short-lived RTC tokens.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
